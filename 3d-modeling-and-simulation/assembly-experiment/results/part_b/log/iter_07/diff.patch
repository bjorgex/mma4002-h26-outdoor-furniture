diff -ruN -x __pycache__ -x '*.glb' best/cad/jig_parts.py design/cad/jig_parts.py
--- best/cad/jig_parts.py	2026-11-20 14:48:08.041427061 +0100
+++ design/cad/jig_parts.py	2026-11-20 15:09:24.436189863 +0100
@@ -51,6 +51,26 @@
     return block - pocket
 
 
+RELIEF_DEPTH, RELIEF_CLEAR = 2.0, 1.0     # base B: recess under each plank end (iter 07)
+
+
+def base_b():
+    """Base A plus a 2 mm recess (plank end + 1 mm) under each plank end, mirrored in y. After the flip the plank
+    ends of frame 1 land flush on the pocket floor (z 9.5): a zero-depth contact the checker flags at random (L09).
+    The frame still sits on the floor around the recesses; floor left 7.5 mm."""
+    bench = bd.import_step(str(BENCH))
+    a = base_a()
+    for c in bench.children:
+        if not c.label.lower().startswith("plank"):
+            continue
+        p = to_base(c)
+        bb = p.bounding_box()                     # whole plank xy box (its end is stepped; tilted backrest planks
+        c = RELIEF_CLEAR                          # get a slightly larger box), + 1 mm, 2 mm below the end (z 9.5)
+        a -= bd.Box(bb.max.X - bb.min.X + 2 * c, bb.max.Y - bb.min.Y + 2 * c, RELIEF_DEPTH + 0.5,
+                    align=(bd.Align.MIN,) * 3).translate((bb.min.X - c, bb.min.Y - c, bb.min.Z - RELIEF_DEPTH))
+    return a.mirror(bd.Plane.XZ)
+
+
 def guide():
     g = bd.import_step(str(GUIDE))
     g = g.rotate(bd.Axis.X, 180)                               # draft jig coordinates -> base-local: z 20..60
@@ -80,7 +100,7 @@
     OUT.mkdir(exist_ok=True)
     CAD.mkdir(exist_ok=True)
     a = base_a()
-    b = a.mirror(bd.Plane.XZ)
+    b = base_b()
     g = guide()
     parts = {"base_a": a, "base_b": b, "guide": g, "plank_jig": plank_jig()}
     plate, squares = ground_base()

diff -ruN -x __pycache__ -x '*.glb' best/cad/jig_parts.py design/cad/jig_parts.py
--- best/cad/jig_parts.py	2026-11-22 02:02:36.585252164 +0100
+++ design/cad/jig_parts.py	2026-11-22 02:55:52.526877466 +0100
@@ -116,9 +116,16 @@
     g = bd.import_step(str(GUIDE))
     g = g.rotate(bd.Axis.X, 180)                               # draft jig coordinates -> base-local: z 20..60
     (x0, y0, z0), (x1, y1, z1) = GRIP_POCKET
+    g = g - bd.Box(x1 - x0, y1 - y0, z1 - z0, align=(bd.Align.MIN,) * 3).translate((x0, y0, z0))
+    # B2 iter 45: notch the far outer corner (top face on base B = local z 20) where link_3 passes at the flip end;
+    # no slot within 45 mm, the guide is never gripped any more.
+    (x0, y0, z0), (x1, y1, z1) = GUIDE_NOTCH
     return g - bd.Box(x1 - x0, y1 - y0, z1 - z0, align=(bd.Align.MIN,) * 3).translate((x0, y0, z0))
 
 
+GUIDE_NOTCH = ((63, -95, 15), (95, -62, 35))
+
+
 def plank_jig(size=None, slots=None):
     x, y, h = (size or PLANK_JIG_SIZE)[:3]
     block = bd.Box(x, y, h, align=(bd.Align.MIN,) * 3)

+    # frame release (iter 46: a 10 mm strip only moved the contact to its wall). Nearest slot vertex 12 mm away.
+    (x0, y0, z0), (x1, y1, z1) = GUIDE_EDGE_NOTCH
     return g - bd.Box(x1 - x0, y1 - y0, z1 - z0, align=(bd.Align.MIN,) * 3).translate((x0, y0, z0))
 
 
 GUIDE_NOTCH = ((63, -95, 15), (95, -62, 35))
